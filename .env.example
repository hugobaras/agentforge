# PostgreSQL (port 5433 pour éviter un Postgres local déjà sur 5432)
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge
POSTGRES_DB=agentforge
POSTGRES_PORT=5433
DATABASE_URL=postgresql://agentforge:agentforge@localhost:5433/agentforge

# Kafka (hôte local). Depuis Docker, utiliser kafka:29092
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=agentforge-api
KAFKA_GROUP_ID=agentforge-consumers
KAFKA_DLQ_TOPIC=agentforge.dlq
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BASE_MS=200

# API
API_PORT=3000

# Frontend (SvelteKit — préfixe PUBLIC_ exposé au client)
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:3000

# Phase 6 — seuil d'approbation (0-100)
EVALUATION_APPROVAL_THRESHOLD=70

# Phase 12 — max de passes implémenteur avant rejet sous le seuil
MAX_IMPLEMENT_ITERATIONS=3

# Phase 13 — timeout des commandes lint / tests / analyse
VERIFIER_COMMAND_TIMEOUT_MS=15000

# Phase 14 — jeton GitHub (PR automatique). Alternative : tenants.githubToken
GITHUB_TOKEN=

# LLM : mock (CI / défaut) ou ollama (daemon local hors Docker)
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=180000
